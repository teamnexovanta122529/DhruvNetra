# ==============================================================================
# DHRUVNETRA - Environment Configuration
# SIH 2026: Remote Management of Indian Antarctic Stations (Maitri & Bharati)
# ==============================================================================

# LLM Provider Configuration (Options: gemini | openai | anthropic | ollama | heuristic)
LLM_PROVIDER=gemini

# Google Gemini API Key (Optional: system falls back to heuristic offline parser if not provided)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL_NAME=gemini-1.5-flash

# OpenAI API Key (Alternative)
# OPENAI_API_KEY=sk-...
# LLM_MODEL_NAME=gpt-4o-mini

# Server & Network Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Simulation & Safety Engine
DEFAULT_STATION=MAITRI

# Real-Time Antarctic Environment & Weather Service (Open-Meteo)
ENVIRONMENT_REFRESH_SECONDS=300
ENVIRONMENT_API_TIMEOUT=10
