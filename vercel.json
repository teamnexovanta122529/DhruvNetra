{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://dhruvnetra-backend.onrender.com/api/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/frontend/dist/assets/$1"
    },
    {
      "source": "/images/(.*)",
      "destination": "/frontend/dist/images/$1"
    },
    {
      "source": "/dhruvnetra_favicon.svg",
      "destination": "/frontend/dist/dhruvnetra_favicon.svg"
    },
    {
      "source": "/icons.svg",
      "destination": "/frontend/dist/icons.svg"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/dist/index.html"
    }
  ]
}
