{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: Start FastAPI Server (Port 8000)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/run.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Backend: Run Full System Audit",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/audit_system.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Backend: Run API Test Suite",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/app/test_api.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Backend: Run Simulation Tests",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/simulation/test_simulation.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  ]
}
