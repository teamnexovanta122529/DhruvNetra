# ==============================================================================
# DHRUVNETRA - Backend Local Configuration
# SIH 2026: Remote Management of Indian Antarctic Stations (Maitri & Bharati)
# ==============================================================================

# LLM Provider Configuration
LLM_PROVIDER=heuristic

# Optional: Add your Gemini API key below to enable live Google Gemini parsing
# GEMINI_API_KEY=your_gemini_api_key_here
# LLM_MODEL_NAME=gemini-1.5-flash

# Server & Network Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Simulation & Station Configuration
DEFAULT_STATION=MAITRI

# Polar Weather Service
ENVIRONMENT_REFRESH_SECONDS=300
ENVIRONMENT_API_TIMEOUT=10
